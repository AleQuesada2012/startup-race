{
  "name": "startup-race",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm content:seed:check && pnpm test:run && pnpm build",
    "content:seed": "node --experimental-strip-types scripts/generateSeed.ts --write",
    "content:seed:check": "node --experimental-strip-types scripts/generateSeed.ts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint && eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:db": "supabase test db",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset"
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@marsidev/react-turnstile": "1.6.1",
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "supabase": "^2.117.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
